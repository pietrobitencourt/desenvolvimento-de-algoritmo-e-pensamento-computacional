                                                                                                                            <while expression="opcao &lt; 0 or opcao &gt; 3">
                                                                                                                                <output expression="&quot;Op&#231;&#227;o errada ou n&#227;o existe.&quot;" newline="True"/>
                                                                                                                                <output expression="&quot;Escolha: [1] Seno | [2] Cosseno | [3] Tangente | [0] para sair&quot;" newline="True"/>
                                                                                                                                <input variable="opcao"/>
                                                                                                                            </while>
                                                                                                                            <output expression="&quot;Digite o &#226;ngulo (em graus): &quot;" newline="True"/>
                                                                                                                            <input variable="angulo"/>
                                                                                                                            <assign variable="anguloRad" expression="angulo * 3.14159 / 180"/>
                                                                                                                            <if expression="opcao = 0">
                                                                                                                                <then>
                                                                                                                                    <output expression="&quot;Programa encerrado!&quot;" newline="True"/>
                                                                                                                                </then>
                                                                                                                                <else>
                                                                                                                                    <if expression="opcao = 1">
                                                                                                                                        <then>
                                                                                                                                            <assign variable="resultadoTrig" expression="SIN(anguloRad)"/>
                                                                                                                                            <output expression="&quot;Seno de &quot; &amp; angulo &amp; &quot;&#176;: &quot; &amp; ToFixed(resultadoTrig, 4)" newline="True"/>
                                                                                                                                        </then>
                                                                                                                                        <else>
                                                                                                                                            <if expression="opcao = 2">
                                                                                                                                                <then>
                                                                                                                                                    <assign variable="resultadoTrig" expression="COS(anguloRad)"/>
                                                                                                                                                    <output expression="&quot;Cosseno de &quot; &amp; angulo &amp; &quot;&#176;: &quot; &amp; ToFixed(resultadoTrig, 4)" newline="True"/>
                                                                                                                                                </then>
                                                                                                                                                <else>
                                                                                                                                                    <if expression="opcao = 3">
                                                                                                                                                        <then>
                                                                                                                                                            <assign variable="resultadoTrig" expression="TAN(anguloRad)"/>
                                                                                                                                                            <output expression="&quot;Tangente de &quot; &amp; angulo &amp; &quot;&#176;: &quot; &amp; ToFixed(resultadoTrig, 4)" newline="True"/>
                                                                                                                                                        </then>
                                                                                                                                                        <else>
                                                                                                                                                            <output expression="&quot;Op&#231;&#227;o errada ou n&#227;o existe.&quot;" newline="True"/>
                                                                                                                                                        </else>
                                                                                                                                                    </if>
                                                                                                                                                </else>
                                                                                                                                            </if>
                                                                                                                                        </else>
                                                                                                                                    </if>
                                                                                                                                </else>
                                                                                                                            </if>
                                                                                                                        </then>
                                                                                                                        <else>
                                                                                                                            <output expression="&quot;Op&#231;&#227;o errada ou n&#227;o existe.&quot;" newline="True"/>
                                                                                                                        </else>
                                                                                                                    </if>
                                                                                                                </else>
                                                                                                            </if>
                                                                                                        </else>
                                                                                                    </if>
                                                                                                </else>
                                                                                            </if>
                                                                                        </else>
                                                                                    </if>
                                                                                </else>
                                                                            </if>
                                                                        </else>
                                                                    </if>
                                                                </else>
                                                            </if>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
